# Canvas to Todoist Sync Configuration
# Copy this file to .env and fill in your values

# Your Todoist API token (get it from https://todoist.com/prefs/integrations)
TODOIST_API_TOKEN=your_todoist_api_token_here

# Your Canvas ICS calendar feed URL
# Find this in Canvas: Calendar -> Calendar Feed (on the right side)
CANVAS_ICS_URL=https://your-institution.instructure.com/feeds/calendars/user_XXXXXX.ics

# Optional Canvas API connection for assignment weights, grades, and verified completion.
# Use Canvas -> Account -> Settings -> New Access Token if your school allows it.
# Cal Poly requires a token request: https://canvassupport.calpoly.edu/user-token-information-and-request
# Leave blank to keep calendar-only syncing. This app only reads Canvas.
CANVAS_API_TOKEN=
# Optional: inferred from the calendar URL when blank.
CANVAS_BASE_URL=

# One study task with a push reminder on each of the days BEFORE a quiz/test.
# 0 disables new study tasks; already completed tasks are never recreated.
STUDY_DAYS_BEFORE=7
STUDY_TIME=18:00
STUDY_TIMEZONE=America/Los_Angeles
# Comma-separated course codes or names to exclude from study tasks only.
# For example: "COMS-1102-V13-2268,Public Speaking"
STUDY_EXCLUDED_COURSES=

# Maintain a separate Canvas Grades project. Requires CANVAS_API_TOKEN.
SYNC_COURSE_GRADES=true

# Assignment deadline reminder; 0 disables it. Separate from daily study reminders.
REMINDER_DAYS_BEFORE=1

# Name of the Todoist project to sync assignments to (will be created if it doesn't exist)
TODOIST_PROJECT_NAME="Canvas Assignments"

# Path to the state file (tracks which assignments have been synced)
STATE_FILE=sync_state.json
